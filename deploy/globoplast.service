[Unit]
Description=Globoplast OEE
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/globoplast
EnvironmentFile=-/etc/globoplast.env
Environment=TZ=America/Sao_Paulo
Environment=GLOBOPLAST_DB=/var/lib/globoplast/database.db
ExecStart=/usr/bin/java -Duser.timezone=America/Sao_Paulo -Xms256m -Xmx2048m -jar /opt/globoplast/globoplast.jar
Restart=always
RestartSec=3
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
